---
import BaseLayout from '../components/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import EngineeringWorkflow from '../components/EngineeringWorkflow.astro';
import FlowSteps from '../components/FlowSteps.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SolutionCard from '../components/SolutionCard.astro';
import StatusTag from '../components/StatusTag.astro';
import { solutions } from '../data/site';
---

<BaseLayout title="제조업 DX·AI" description="제조업 시스템 구축 경험과 ML, DL, LLM 기술을 연결해 스마트공장, 산업 AI, 생성형 AI, 엔지니어링 자동화를 지원합니다." path="/">
  <section class="home-hero">
    <div class="page-hero-image" aria-hidden="true"></div>
    <div class="container hero-content">
      <p class="eyebrow"><span></span>MANUFACTURING × AI</p>
      <h1>Manufacturing Expertise. <br /><span>AI-Driven Innovation.</span></h1>
      <p class="hero-korean">제조 현장을 이해하고, AI로 업무를 혁신합니다.</p>
      <p class="hero-description">제조 시스템 구축 경험과 AI 기술을 결합해 스마트공장, 지능형 분석, 생성형 AI, 엔지니어링 자동화 솔루션을 제공합니다.</p>
      <div class="button-row">
        <a class="button button-primary" href="/solutions/">솔루션 살펴보기 <span aria-hidden="true">↗</span></a>
        <a class="button button-outline-light" href="/contact/">프로젝트 상담하기</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="solutions-heading">
    <div class="container">
      <SectionHeading id="solutions-heading" eyebrow="OUR SOLUTIONS" title="제조 현장에 필요한 DX와 AI를 연결합니다" text="기술을 나열하기보다 현장 업무와 데이터, 기존 시스템을 이해하고 적용 가능한 범위부터 설계합니다." />
      <div class="solution-grid">
        {solutions.map((solution) => <SolutionCard solution={solution} compact />)}
      </div>
    </div>
  </section>

  <section class="section section-muted" aria-labelledby="scenarios-heading">
    <div class="container scenario-layout">
      <SectionHeading id="scenarios-heading" eyebrow="WORK SCENARIOS" title="현장의 업무에서 시작하는 적용 시나리오" text="아래는 제조 업무에 적용할 수 있는 기술 검토 영역입니다. 개별 고객의 구축 실적을 뜻하지 않습니다." />
      <ol class="scenario-list">
        <li><span class="scenario-number">01</span><div><h3>생산 운영</h3><p>생산 계획, 작업 지시, 실적 관리 등 운영 정보를 연결합니다.</p></div></li>
        <li><span class="scenario-number">02</span><div><h3>설비 관리</h3><p>설비 데이터의 수집·분석과 현장 점검 업무를 검토합니다.</p></div></li>
        <li><span class="scenario-number">03</span><div><h3>품질 관리</h3><p>품질 정보와 공정 데이터를 살펴 분석·예측 가능성을 확인합니다.</p></div></li>
        <li><span class="scenario-number">04</span><div><h3>사내 지식 검색</h3><p>업무 문서와 기술 자료를 검색·요약하는 방법을 설계합니다.</p></div></li>
        <li><span class="scenario-number">05</span><div><h3>CATIA 설계 변경</h3><p>기존 모델을 읽고 승인된 변경 경로를 실행·확인하는 기술을 개발 중입니다.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="experience-heading">
    <div class="container experience-preview">
      <SectionHeading id="experience-heading" eyebrow="OUR EXPERIENCE" title="제조 시스템 구축과 AI 적용 경험" text="제조 정보시스템·스마트공장, ML/DL/LLM, CATIA 설계 자동화 경험을 바탕으로 현장 업무에 맞는 소프트웨어를 설계·구축합니다." />
      <CaseStudyCard pending href="/experience/" />
    </div>
  </section>

  <section class="section section-muted" aria-labelledby="products-heading">
    <div class="container product-preview">
      <div class="product-preview-copy">
        <p class="eyebrow eyebrow-dark"><span></span>PRODUCTS & R&D</p>
        <h3 id="products-heading">제조 업무에 연결되는 제품을 연구합니다</h3>
        <StatusTag label="개발 중 · 내부 검증 범위 제한" />
        <p>CATIA Engineering Agent는 기존 모델을 확인하고, 승인된 제한 경로에서 변경을 실행한 뒤 결과를 점검하는 흐름을 개발하고 있습니다. 일반 CATIA 모델과 모든 기능을 지원하는 제품은 아닙니다.</p>
        <a class="text-link" href="/products/">제품·연구 진행 상태 보기 <span aria-hidden="true">→</span></a>
      </div>
      <div>
        <EngineeringWorkflow />
        <div class="research-preview-note">
          <span class="index-number">R&amp;D</span>
          <div><strong>Agentic Knowledge Management System</strong><p>연구 후보 · 공개 시연 없음</p></div>
          <a class="text-link" href="/products/#knowledge-management">상태 확인 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="process-heading">
    <div class="container">
      <SectionHeading id="process-heading" eyebrow="PROJECT APPROACH" title="문제 정의부터 현장 적용까지 함께합니다" text="기술 적용 가능성과 운영 조건을 확인하며 고객에게 필요한 범위로 단계를 설계합니다." />
      <FlowSteps />
    </div>
  </section>

  <CTASection />
</BaseLayout>
