---
import BaseLayout from '../components/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import FlowSteps from '../components/FlowSteps.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { serviceItems } from '../data/site';
---

<BaseLayout title="서비스" description="제조 정보시스템, 스마트공장, 산업 AI, LLM·Agent, 설계 자동화와 AI PoC를 프로젝트 범위에 맞춰 지원합니다." path="/services/">
  <PageHero eyebrow="OUR SERVICES" title="현장에 필요한 기술을, 필요한 범위로" description="컨설팅과 PoC부터 시스템 구축과 지속적인 개선까지 제조 업무의 과제에 맞춰 함께합니다." primaryLabel="수행 범위 상담하기" secondaryLabel="프로젝트 진행 절차" secondaryHref="#process" />

  <section class="section" aria-labelledby="service-list-heading">
    <div class="container">
      <SectionHeading id="service-list-heading" eyebrow="SERVICES" title="제조 현장을 위한 기술 서비스" text="고객의 업무와 시스템을 확인한 뒤 실제 수행 가능한 범위와 기술을 협의합니다." />
      <div class="services-grid">
        {serviceItems.map((service) => <ServiceCard {...service} />)}
      </div>
      <p class="service-scope-note">개별 서비스의 기술 범위, 일정, 비용, 운영 지원은 고객 환경과 요구사항을 확인한 뒤 별도로 합의합니다.</p>
    </div>
  </section>

  <section class="section section-muted" id="process" aria-labelledby="process-heading">
    <div class="container">
      <SectionHeading id="process-heading" eyebrow="PROJECT APPROACH" title="현황 분석부터 적용과 개선까지" text="검증 가능한 범위부터 시작해 현장 피드백과 운영 조건을 반영합니다." />
      <FlowSteps />
    </div>
  </section>

  <CTASection title="함께 해결할 제조 과제가 있으신가요?" text="현황과 목표를 확인한 뒤 적합한 컨설팅·PoC·구축 범위를 제안합니다." label="프로젝트 상담하기" />
</BaseLayout>
