---
import BaseLayout from '../components/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';

const experienceAreas = [
  {
    number: '01',
    title: '제조 정보시스템 · 스마트공장',
    description: '제조 현장의 업무 흐름을 이해하고 정보시스템 구축, 스마트공장 구축·고도화, 기존 시스템 연계를 지원합니다.',
    capabilities: ['현업 업무 분석과 시스템 설계', '생산·설비·품질 데이터 연계', '기존 정보시스템 개선과 통합'],
  },
  {
    number: '02',
    title: 'ML · DL · LLM 소프트웨어',
    description: '제조 데이터와 업무 요구를 바탕으로 분석 모델과 LLM 기반 애플리케이션을 개발하고 기존 업무 흐름에 연결합니다.',
    capabilities: ['ML/DL 분석·예측 모델 개발', 'LLM/RAG 지식 활용과 AI Agent', 'PoC부터 시스템 적용·개선까지'],
  },
  {
    number: '03',
    title: 'CATIA · 설계 자동화',
    description: 'CATIA V5와 설계 업무 경험을 바탕으로 기존 모델 분석, 반복 변경 자동화와 CAD/PLM 연계를 검토합니다.',
    capabilities: ['CATIA V5 기반 설계 업무 개선', '승인된 변경 절차와 결과 확인', 'Engineering Agent 연구·개발'],
  },
];
---

<BaseLayout title="구축 경험" description="제조 정보시스템과 스마트공장 구축, ML/DL/LLM 개발, CATIA 설계 자동화 경험을 바탕으로 제조 업무의 DX를 지원합니다." path="/experience/">
  <PageHero eyebrow="OUR EXPERIENCE" title="제조 시스템 구축부터 현장 AI까지 연결합니다" description="제조 정보시스템과 스마트공장 구축 경험, ML/DL/LLM 기술 개발, CATIA 및 설계 자동화 경험을 바탕으로 고객 업무에 맞는 소프트웨어를 설계·구축합니다." />

  <section class="section" aria-labelledby="experience-capabilities-heading">
    <div class="container">
      <SectionHeading id="experience-capabilities-heading" eyebrow="CORE EXPERIENCE" title="제조 현장과 기술을 잇는 구축 역량" text="현업 과제를 분석하고 시스템과 AI를 필요한 범위로 설계해 실제 업무에 연결합니다." />
      <div class="experience-capability-grid">
        {experienceAreas.map((area) => (
          <article class="experience-capability">
            <span class="experience-capability-number">{area.number}</span>
            <h3>{area.title}</h3>
            <p>{area.description}</p>
            <ul>{area.capabilities.map((capability) => <li>{capability}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted" aria-labelledby="experience-disclosure-heading">
    <div class="container">
      <SectionHeading id="experience-disclosure-heading" eyebrow="PROJECT APPROACH" title="요구사항부터 현장 적용까지" text="업무·데이터·기존 시스템을 살펴 실행 가능한 프로젝트 범위와 검증 방법을 함께 정합니다." />
      <div class="evidence-steps">
        <article class="evidence-step"><span>01</span><h3>업무와 시스템 분석</h3><p>현장 과제, 데이터, 연계 조건을 확인합니다.</p></article>
        <article class="evidence-step"><span>02</span><h3>설계와 기술 검증</h3><p>요구에 맞는 시스템 구조와 AI 적용 방식을 검토합니다.</p></article>
        <article class="evidence-step"><span>03</span><h3>구축과 개선</h3><p>합의한 범위를 적용하고 사용 결과에 따라 개선합니다.</p></article>
      </div>
      <p class="experience-proof-note"><strong>공개 사례 안내</strong>고객명과 정량 성과는 근거 및 공개 승인이 확인된 경우에만 게시합니다. 현재 페이지는 Moonworld의 사업 역량과 수행 영역을 소개하며, 확인되지 않은 고객 사례나 수치를 표시하지 않습니다.</p>
    </div>
  </section>

  <CTASection title="비슷한 제조 과제를 검토 중이신가요?" text="현장 업무와 시스템 상황을 살펴보고 필요한 범위부터 함께 정의합니다." label="구축 경험 상담하기" />
</BaseLayout>
