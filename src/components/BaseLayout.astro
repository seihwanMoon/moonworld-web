---
import '../styles/global.css';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = Astro.url.pathname } = Astro.props;
const pageTitle = title === 'MOONWORLD' ? title : `${title} | MOONWORLD`;
const canonical = new URL(path, 'https://moonworld.uk').toString();
const socialImage = 'https://moonworld.uk/images/manufacturing-hero.webp';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0B1730" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="128x128" href="/images/moonworld-mark.png" />
    <link rel="apple-touch-icon" href="/images/moonworld-mark.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MOONWORLD" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="정밀 제조 현장에서 설비를 살펴보는 엔지니어" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
