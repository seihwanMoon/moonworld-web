---
interface Props {
  title?: string;
  text?: string;
  label?: string;
}

const { title = '제조 현장의 과제를 함께 이야기해 보세요', text = '현장의 업무와 기술 제약을 살펴보고, 실행 가능한 다음 단계를 함께 정합니다.', label = '프로젝트 상담하기' } = Astro.props;
---

<section class="cta-section">
  <div class="cta-image" aria-hidden="true"></div>
  <div class="container cta-inner">
    <div>
      <p class="eyebrow"><span></span>LET'S BUILD TOGETHER</p>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <a class="button button-primary" href="/contact/">{label}<span aria-hidden="true">↗</span></a>
  </div>
</section>
